{
  "name": "formspace-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "start:node": "node server/node-server.mjs",
    "test": "node scripts/test-api.mjs",
    "test:node": "node scripts/test-node-server.mjs",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/prepare-model-decoders.mjs",
    "prebuild": "node scripts/prepare-model-decoders.mjs"
  },
  "dependencies": {
    "camera-controls": "3.1.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "lucide-react": "^1.31.0",
    "occt-import-js": "0.0.23",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
