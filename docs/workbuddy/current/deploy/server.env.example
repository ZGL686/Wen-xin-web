# Copy to a private /etc/changxu/server.env; do not commit real keys.
# Create /var/lib/changxu-data and grant the service user access first.
FORMSPACE_HOST=127.0.0.1
FORMSPACE_PORT=8788
FORMSPACE_DATA_DIR=/var/lib/changxu-data
# Default: local FS. COS is unverified in production; validate in a private test bucket.
# All four COS variables are required together when enabling COS.
# FORMSPACE_COS_BUCKET=your-private-bucket-appid
# FORMSPACE_COS_REGION=your-region
# FORMSPACE_COS_SECRET_ID=configure-on-server-only
# FORMSPACE_COS_SECRET_KEY=configure-on-server-only
