* text=auto
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.png binary
*.webp binary
*.max filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve the sealed delivery's exact bytes so its SHA manifest survives checkout.
deliverables/Cute_House_2026/*.json -text
deliverables/Cute_House_2026/*.txt -text
